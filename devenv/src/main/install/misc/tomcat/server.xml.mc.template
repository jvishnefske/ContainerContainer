<Server port="8015" shutdown="SHUTDOWN">
    <Service name="Catalina">
        <Connector port="${artifactory.port||8081}" sendReasonPhrase="${artifactory.tomcat.connector.sendReasonPhrase||false}" relaxedPathChars='[]' relaxedQueryChars='[]' maxThreads="${artifactory.tomcat.connector.maxThreads||200}" ${artifactory.tomcat.connector.extraConfig||_EMPTY_}/>

        <Connector port="${artifactory.tomcat.maintenanceConnector.port||8091}" address="localhost" maxThreads="${artifactory.tomcat.maintenanceConnector.maxThreads||5}" acceptCount="${artifactory.tomcat.maintenanceConnector.acceptCount||5}" ${artifactory.tomcat.maintenanceConnector.extraConfig||_EMPTY_} />

        <!-- Must be at least the value of artifactory.access.client.max.connections -->
        <Connector port="${access.http.port||8040}" sendReasonPhrase="${access.tomcat.connector.sendReasonPhrase||false}" maxThreads="${access.tomcat.connector.maxThreads||50}" address="localhost" ${access.tomcat.connector.extraConfig||_EMPTY_}/>
        
        <Connector port="${mc.port||8080}" sendReasonPhrase="${mc.tomcat.connector.sendReasonPhrase||false}" maxThreads="${mc.tomcat.connector.maxThreads||50}" ${mc.tomcat.connector.extraConfig||_EMPTY_}/>

        ${shared.tomcat.connector.extra||_EMPTY_}

        <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost" workDir="${shared.tomcat.workDir||${JF_PRODUCT_HOME}/var/work/artifactory/tomcat}" appBase="webapps" startStopThreads="3">
                <Valve className="org.apache.catalina.valves.ErrorReportValve" showReport="false" showServerInfo="false"/>
            </Host>
        </Engine>
    </Service>

</Server>

