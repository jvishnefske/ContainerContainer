<Server port="8015" shutdown="SHUTDOWN">
    <Service name="Catalina">
        <Connector port="${artifactory.port||8081}" sendReasonPhrase="${artifactory.tomcat.connector.sendReasonPhrase||false}" relaxedPathChars='[]' relaxedQueryChars='[]' maxThreads="${artifactory.tomcat.connector.maxThreads||200}" address="localhost" ${artifactory.tomcat.connector.extraConfig||_EMPTY_}/>
        
        <Connector port="${artifactory.tomcat.maintenanceConnector.port||8091}" address="localhost" maxThreads="${artifactory.tomcat.maintenanceConnector.maxThreads||5}" acceptCount="${artifactory.tomcat.maintenanceConnector.acceptCount||5}" ${artifactory.tomcat.maintenanceConnector.extraConfig||_EMPTY_} />
        
        <Connector port="${artifactory.tomcat.httpsConnector.port||8443}" protocol="org.jfrog.tomcat.connector.HTTP11NioProtocol" maxThreads="${artifactory.tomcat.connector.maxThreads||200}" bindOnInit="false" scheme="https" secure="true"
        waitForSSLCertificateFile="${artifactory.tomcat.httpsConnector.certificateFile||${JF_PRODUCT_HOME}/var/data/router/keys/server.crt}"
        waitForSSLCertificateKeyFile="${artifactory.tomcat.httpsConnector.certificateKeyFile||${JF_PRODUCT_HOME}/var/data/router/keys/server.key}" ${artifactory.tomcat.httpsConnector.extraConfig||_EMPTY_}/>

        <Connector port="${artifactory.tomcat.httpsConnector.port||8443}" protocol="org.apache.coyote.http11.Http11NioProtocol" 
        relaxedPathChars='${artifactory.tomcat.connector.relaxedPathChars||_SQUARE_BRACKETS_}' 
        relaxedQueryChars='${artifactory.tomcat.connector.relaxedQueryChars||_SQUARE_BRACKETS_}' 
        maxThreads="${artifactory.tomcat.connector.maxThreads||200}" bindOnInit="false" scheme="https" 
        secure="true" SSLEnabled="true" ${artifactory.tomcat.httpsConnector.extraConfig||_EMPTY_}>
            <SSLHostConfig>
                <Certificate certificateFile="${artifactory.tomcat.httpsConnector.certificateFile||${JF_PRODUCT_HOME}/var/data/router/keys/server.crt}" 
                certificateKeyFile="${artifactory.tomcat.httpsConnector.certificateKeyFile||${JF_PRODUCT_HOME}/var/data/router/keys/server.key}" 
                ${artifactory.tomcat.httpsConnector.sslHostConfig.extraConfig||_EMPTY_} />
            </SSLHostConfig>
        </Connector>

        <!-- Must be at least the value of artifactory.access.client.max.connections -->
        <Connector port="${access.http.port||8040}" sendReasonPhrase="${access.tomcat.connector.sendReasonPhrase||false}" maxThreads="${access.tomcat.connector.maxThreads||50}" address="localhost" ${access.tomcat.connector.extraConfig||_EMPTY_}/>
        
        <Connector port="${mc.port||8080}" sendReasonPhrase="${mc.tomcat.connector.sendReasonPhrase||false}" maxThreads="${mc.tomcat.connector.maxThreads||50}" ${mc.tomcat.connector.extraConfig||_EMPTY_}/>

        ${shared.tomcat.connector.extra||_EMPTY_}

        <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost" workDir="${shared.tomcat.workDir||${JF_PRODUCT_HOME}/var/work/artifactory/tomcat}" appBase="webapps" startStopThreads="3">
                <Valve className="org.apache.catalina.valves.ErrorReportValve" showReport="false" showServerInfo="false"/>
            </Host>
        </Engine>
    </Service>

</Server>

