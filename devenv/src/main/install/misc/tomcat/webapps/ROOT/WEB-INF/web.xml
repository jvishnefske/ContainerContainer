<?xml version="1.0" encoding="UTF-8"?>
<!--
  ROOT webapp hardening: blocks direct access to any static content.
  Rewrite rules (Docker /v2/, root redirect) still work because the
  RewriteValve runs before servlet mapping.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- Deny all direct file serving by disabling listings and requiring no files to exist -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>deny-all</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>

</web-app>
