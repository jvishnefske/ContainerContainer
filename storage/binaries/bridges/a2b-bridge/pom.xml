<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.artifactory.sh</groupId>
        <artifactId>storage-handler-bridges-parent</artifactId>
        <version>7.161.15</version>
    </parent>

    <artifactId>storage-handler-a2b-bridge</artifactId>
    <name>Storage Handler A2B Bridge</name>

    <description>
        Bridge module - main storage-handler interface for artifactory usage
        Allow artifactory beans to find binary-store beans
        (from) artifactory spring beans
        (to) binary-store beans
        * Implements the artifactory-binary-store service api (real and mock)
    </description>

    <dependencies>
        <!--   dependencies for internal artifactory modules     -->
        <dependency>
            <groupId>org.artifactory</groupId>
            <artifactId>artifactory-common</artifactId>
        </dependency>
        <!--   dependencies for storage handler modules          -->
        <dependency>
            <groupId>org.jfrog.storage</groupId>
            <artifactId>binary-store-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jfrog.sh</groupId>
            <artifactId>storage-client</artifactId>
            <version>${jfrog.storage.version}</version>
        </dependency>
        <dependency>
            <groupId>org.artifactory</groupId>
            <artifactId>artifactory-config</artifactId>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--test-jar of this module is being used by binary-store-filestore and artifactory-itest and addons -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
