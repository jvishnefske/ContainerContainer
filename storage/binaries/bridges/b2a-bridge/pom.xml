<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.artifactory.sh</groupId>
        <artifactId>storage-handler-bridges-parent</artifactId>
        <version>7.161.15</version>
    </parent>

    <artifactId>storage-handler-b2a-bridge</artifactId>
    <name>Storage Handler B2A Bridge</name>

    <description>
        Bridge module - allow binary-store beans to find artifactory beans
        (from) binary-store beans
        (to) artifactory spring beans
        * Implements the BinaryStoreConfigService interface for storage-handler to find artifactory runtime beans
    </description>

    <dependencies>
        <!--   dependencies for internal artifactory modules     -->
        <dependency>
            <groupId>org.artifactory.sh</groupId>
            <artifactId>storage-handler-a2b-bridge</artifactId>
        </dependency>
        <dependency>
            <groupId>org.artifactory</groupId>
            <artifactId>artifactory-storage-db</artifactId>
        </dependency>
        <!--   dependencies for storage handler modules          -->
        <dependency>
            <groupId>org.jfrog.storage</groupId>
            <artifactId>binary-store-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
