<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.artifactory.sh</groupId>
    <artifactId>storage-handler-binaries-bom</artifactId>
    <version>7.161.15</version>
    <packaging>pom</packaging>

    <name>Storage Handler Bridges Bom</name>
    <description>
        Dependency management for all org.artifactory.sh inner modules
        should be used as an import to global dependencyManagement in artifactory
    </description>

    <properties>
        <commons.jacoco.version>0.8.15</commons.jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.artifactory.sh</groupId>
                <artifactId>storage-handler-a2b-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.artifactory.sh</groupId>
                <artifactId>storage-handler-b2a-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.artifactory.sh</groupId>
                <artifactId>storage-handler-gc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- tests-->

            <!-- contains mocks for unit tests -->
            <dependency>
                <groupId>org.artifactory.sh</groupId>
                <artifactId>storage-handler-a2b-bridge</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <!-- contains bridge for interation tests -->
            <dependency>
                <groupId>org.artifactory.sh</groupId>
                <artifactId>storage-handler-itest-bridge</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- adding this so jacoco plugin will not fail -->
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${commons.jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
