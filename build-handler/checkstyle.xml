<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- All Checks options can be found at: https://checkstyle.org/checks.html-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <!-- Set default severity to error - will fail the build in most cases on violation -->
    <property name="severity" value="error"/>

    <property name="fileExtensions" value="java, properties, xml"/>
    <!-- Excludes all 'module-info.java' files              -->
    <!-- See https://checkstyle.org/config_filefilters.html -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module\-info\.java$"/>
    </module>
    <!-- Checks for whitespace                               -->
    <!-- See http://checkstyle.sf.net/config_whitespace.html -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Line length of Java files is limited to 150 -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="150"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://|&lt;code&gt;"/>
    </module>

    <module name="TreeWalker">
        <!-- No star imports -->
        <module name="AvoidStarImport"/>

        <!-- Forbid unused imports -->
        <module name="UnusedImports"/>

        <!-- Non-inner classes should have the correct file name -->
        <module name="OuterTypeFilename"/>

        <!-- Checks for braces around code blocks. -->
        <module name="NeedBraces"/>

        <!-- Checks that all constructors are grouped together.. -->
        <module name="ConstructorsDeclarationGrouping"/>

        <!-- Only one outer class -->
        <module name="OneTopLevelClass"/>

        <!-- Check that the default is after all the cases in a switch statement -->
        <module name="DefaultComesLast"/>

        <!-- Don't wrap import and package statements,-->
        <module name="NoLineWrap"/>

        <module name="OneStatementPerLine"/>

        <module name="AnnotationUseStyle">
            <!-- Do not force a specific style for annotation elements  -->
            <property name="elementStyle" value="ignore"/>
            <!-- Do force trailing comma -->
            <property name="trailingArrayComma" value="ignore"/>
            <!-- @Test instead of @Test() -->
            <property name="closingParens" value="never"/>
        </module>
    </module>
</module>
