lombok.addLombokGeneratedAnnotation=true

# Add the @ConstructorProperties annotation to support Jersey deserialization (see v1.16.20 changelog).
#
lombok.anyConstructor.addConstructorProperties=true

# Generate `Objects.requireNonNull(<name>, ...)` instead of `if (<name> == null) { ... }`.
#
lombok.nonNull.exceptionType=JDK
