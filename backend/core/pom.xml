    <build>
        <plugins>
            <!-- W7: the WASM plugin runtime stays pure Java. Only the listed Endive artifacts (interpreter, WASI,
                 parser, logging, and the bytecode compiler should a manifest ever opt in) may enter the build;
                 Endive's native backends (the Cranelift-based Redline and anything else) and the JNR/JFFI native
                 bridges are banned outright. Endive 1.2.0's artifacts have no transitive dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>wasm-runtime-is-pure-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>run.endive:*</exclude>
                                        <exclude>com.github.jnr:*</exclude>
                                        <exclude>org.lwjgl:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>run.endive:wasm:1.2.0</include>
                                        <include>run.endive:runtime:1.2.0</include>
                                        <include>run.endive:wasi:1.2.0</include>
                                        <include>run.endive:log:1.2.0</include>
                                        <include>run.endive:compiler:1.2.0</include>
                                    </includes>
                                    <message>The WASM runtime must stay pure Java (design.md W7): only the
                                        interpreter-side Endive artifacts are allowed, no native backend.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
